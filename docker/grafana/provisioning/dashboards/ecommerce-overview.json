{
 "uid": "ecommerce-overview",
 "title": "E-commerce microservices overview",
 "tags": [
  "ecommerce",
  "spring-boot"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "description": "Live health of the 10 services: traffic, errors, response time, memory, CPU, database connections and circuit breakers.",
 "templating": {
  "list": [
   {
    "name": "DS",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "hide": 2,
    "current": {},
    "refresh": 1
   },
   {
    "name": "application",
    "label": "Service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS}"
    },
    "query": {
     "query": "label_values(up{job=\"ecommerce\"}, application)",
     "refId": "v"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Services up",
   "description": "Share of the monitored services that answered the last scrape (100% = all up).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(up{job=\"ecommerce\"}) / count(up{job=\"ecommerce\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests / sec",
   "description": "HTTP requests handled per second by the selected services. A request that passes the gateway is counted by the gateway and by the service behind it.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Server errors (5xx) / sec",
   "description": "Requests answered with a 5xx status. Should stay at 0.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",status=~\"5..\"}[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.0001
       }
      ]
     },
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Average response time",
   "description": "Average duration of a request over the last minute.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(rate(http_server_requests_seconds_sum{application=~\"$application\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Open circuit breakers",
   "description": "A breaker is open when a called service keeps failing; calls to it are cut off until it recovers.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "count(resilience4j_circuitbreaker_state{state=\"open\"} == 1) or vector(0)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "JVM heap used",
   "description": "Memory used by Java objects across the selected services.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\",application=~\"$application\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests per second, by service",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Average response time, by service",
   "description": "Average request duration. A gap means the service had no requests in that minute.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (application)(rate(http_server_requests_seconds_sum{application=~\"$application\"}[1m])) / sum by (application)(rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Responses by HTTP status",
   "description": "2xx = success, 4xx = client errors (wrong login, not found), 5xx = server errors.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 40,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal",
       "group": "A"
      }
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Client and server errors, by service",
   "description": "Only 4xx and 5xx responses.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{application=~\"$application\",status=~\"[45]..\"}[1m]))",
     "legendFormat": "{{application}} {{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Busiest endpoints (last 5 min)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 20
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "topk(10, sum by (application, uri) (rate(http_server_requests_seconds_count{application=~\"$application\",uri!~\"/actuator.*|/eureka.*|UNKNOWN\"}[5m])))",
     "legendFormat": "{{application}} {{uri}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "color": {
      "mode": "continuous-BlPu"
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 12,
   "type": "bargauge",
   "title": "Slowest endpoints (last 5 min, average)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 20
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "topk(10, sum by (application, uri) (rate(http_server_requests_seconds_sum{application=~\"$application\",uri!~\"/actuator.*|/eureka.*|UNKNOWN\"}[5m])) / sum by (application, uri) (rate(http_server_requests_seconds_count{application=~\"$application\",uri!~\"/actuator.*|/eureka.*|UNKNOWN\"}[5m])))",
     "legendFormat": "{{application}} {{uri}}",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "continuous-BlPu"
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "JVM heap used, by service",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 29
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\",application=~\"$application\"})",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "CPU usage, by service",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 29
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "process_cpu_usage{application=~\"$application\"}",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Live threads, by service",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 29
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "jvm_threads_live_threads{application=~\"$application\"}",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Database connections in use",
   "description": "Active MySQL connections per service (pool limit is shown in the table legend of hikaricp_connections_max).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 37
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "hikaricp_connections_active{application=~\"$application\"}",
     "legendFormat": "{{application}} {{pool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "never",
      "spanNulls": true
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 17,
   "type": "table",
   "title": "Circuit breakers",
   "description": "Current state of every circuit breaker (closed = healthy).",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 37
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS}"
     },
     "expr": "resilience4j_circuitbreaker_state{application=~\"$application\"} == 1",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "Value": true
      },
      "renameByName": {
       "application": "Service",
       "name": "Breaker",
       "state": "State"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 18,
   "type": "bargauge",
   "title": "Service uptime",
   "description": "Time since each service last started.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
